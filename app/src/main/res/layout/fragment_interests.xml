<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".InterestsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/interests_title"
            android:textColor="@color/text_primary_dark"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/interests_subtitle"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/interestsChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAlgorithms"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_algorithms" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDataStructures"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_data_structures" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWebDev"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_web_dev" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTesting"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_testing" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMobile"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_mobile" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCloud"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_cloud" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAi"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_ai" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSecurity"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_security" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDatabases"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_databases" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUx"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interest_ux" />
        </com.google.android.material.chip.ChipGroup>

        <Button
            android:id="@+id/interestsNextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/next_button"
            android:textAllCaps="false"
            android:textColor="@color/text_primary_dark"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
